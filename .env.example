# Copy to .env in the repository root. Never commit real credentials.
# dotnet run loads these directly. Heroku uses the same configuration keys.
GoogleDrive__ClientId=replace-with-google-client-id
GoogleDrive__ClientSecret=replace-with-google-client-secret
Frontend__Url=http://localhost:5173
Frontend__AllowedOrigins=http://localhost:5173

# Optional: existing two-container Docker Compose deployment.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5207/api

# MongoDB Atlas: URL-encode any reserved characters in the username/password.
MongoDB__ConnectionString=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MongoDB__DatabaseName=Encrypz
